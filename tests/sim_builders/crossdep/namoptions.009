&RUN
iexpnr  = 009
lwarmstart  = .false.
startfile  = 'initdlatestmx000y000.002'
!runtime  = 864000.0
!runtime  = 100800.0
runtime  = 10.0
trestart  = -1
dtav_glob   = 600
timeav_glob = 3600
ltotruntime = .true.
dtmax = 10
ladaptive = .true.
peclet = 0.1
irandom = 1
randthl = 0.01
randqt = 2.5e-5
! number of tracers
nsv = 1
nprocx = 0
nprocy = 0
/

&SOLVER
solver_id = 100
/

&DOMAIN
itot = 100
jtot = 160
kmax  = 128
kmax_soil = 4

xsize = 5000
ysize = 8000

xlat  = 51.967
xlon  = 4.917
xday  = 253
xtime = 0
xyear = 2021
/

&PHYSICS
!lmoist = .true.
lcoriol = .true.
ltimedep = .true.
iradiation = 3
igrw_damp = 3
timerad = 60
/

&NAMSURFACE
ps = 1e5
thls = 300
! isurf 1: interactive scheme; isurf 11: lsm
isurf = 11
! Roughness length for momentum
z0mav = 0.075
! Roughness length for heat
z0hav = 0.003
Cskinav = 0
lambdaskinav = 10
Qnetav = 0
Wlav = 0.0001
rsminav = 100
rssoilminav = 50
LAIav = 2.5
cvegav = 1
albedoav = 0.23
gDav = 0
! area average root fraction
rootfav = 0.40 0.30 0.30 0.00
! area average deep soil temp (K)
tsoildeepav  = 289.29476884238244
! area average soil temp (K)
tsoilav  = 286 290 290 289
! area average rel. soil water content
phiwav  = 0.16 0.17 0.16 0.23
!volumetric soil porosity
phi  = 0.403
! volumetric moisture at wilting point
phiwp  = 0.059
! volumetric moisture at field capacity
phifc  = 0.242
/

&NAMLSM
lheterogeneous = .true.
! number of land use types
nlu = 10
lfreedrainage  = .false. 
dz_soil = 1.89 0.72 0.21 0.07 
iinterp_t = 1
iinterp_theta = 4
/

&DYNAMICS
cu =  0.
cv =  0.

iadv_mom = 52
iadv_tke = 52
iadv_thl = 52
iadv_qt  = 52
/

&NAMNUDGE
lnudge=.true.
tnudgefac=10800
/

&NAMSUBGRID
ldelta = .false.
cn = 0.76
ch1 = 1.
/

&NAMMICROPHYSICS
imicro = 0
l_sb = .true.
Nc_0 = 200e6
/

&NAMRADIATION
lCnstAlbedo = .true.
/

&NAMBULKMICROSTAT
lmicrostat = .false.
!timeav = 300
!dtav = 300
/

&NAMCHECKSIM
tcheck = 0
/

&NAMNETCDFSTATS
lnetcdf = .true.
lsync   = .true.
/

&NAMTIMESTAT
! calculation of time series
ltimestat = .true.
/

&NAMGENSTAT
! generic slab averaged statistics
lstat  = .true.
/

&NAMBUDGET
! turbulent TKE budget calculation
lbudget = .true.
/

&NAMSTATTEND
! tendencies of prognostic variables
ltend  = .false.
/

&NAMRADSTAT
! slabaveraged radiation statistics
lstat = .false.
!dtav   = 300
!timeav = 1800
/

&NAMLSMSTAT
! land surface statistics
lstat = .false.
!dtav   = 300
!timeav = 1800.
/

&NAMCROSSSECTION
! dumping of crosssections of the field
lcross = .false.
crossheight = 1
crossplane  = 64
crossortho  = 64
/

&NAMLSMCROSSSECTION
lcross = .false.
! soil layers, numbered from bottom up
crossheight = 4
/

&NAMEMISSION
l_emission = .true.
kemis      = 3
! svskip     = 2
! svco2sum   = -1
nemis      = 1
emisnames  = 'nh3'
! l_scale     = .false.
! scalefactor = 0.1,  0.1, 1.0, 0.1
/

&NAMDEPOSITION
ldrydep = .true.
nh3_avg = 10.
so2_avg = 1.
/

&NAMDATETIME
l_datetime = .true.
startyear  = 2021
startmonth = 9
startday   = 10
/

&NAMFIELDDUMP
! dumping of 3d-fields
lfielddump = .true.
!lbinary    = .false.
!ldiracc    = .false.
klow       = 1
khigh      = 80
ncoarse    = 1
tmin       = 0
tmax       = 0
/

&NAMCHEM
lchem       = .false.
tnor        = 22
nchsp       = 20
ldiuvar     = .true. 
lchconst    = .false.
h_ref       = 12.
lcloudKconst= .false.
t_ref	    = 293.
p_ref	    = 100000.
q_ref	    = 5.0e-3
lchmovie    = .false.
dtchmovie   = 60.
lsegr       = .false.
/

&NAMDEPCROSSSECTION
ldepcrosssection = .true.
dtav = 1
!lbinary = .false.
! dtav = 900
/

&NAMTRACERS
ltracers    = .true.
tracernames = 'nh3'
! tracernames = 'inert', 'o3', 'o1d', 'no', 'no2', 'n2o5', 'ch2o','no3','mvk','iso','ro2','oh','ho2','co','h2o','produc','o2','n2','hno3','h2o2'
/

&NAMBOUNDSET
lboundopen = .true. !if false, set to cyclic bound conditions
fillvalues = 10   !as many values as nsv
/
